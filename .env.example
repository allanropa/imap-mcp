# Servidor IMAP con TLS. Usa una contraseña de aplicación si tu proveedor la requiere.
IMAP_HOST=imap.example.com
IMAP_PORT=993
IMAP_USER=usuario@example.com
IMAP_PASSWORD=pon_aqui_una_contrasena_de_aplicacion

# Cuenta separada para correos financieros.
IMAP_FINANCIAL_HOST=imap.example.com
IMAP_FINANCIAL_PORT=993
IMAP_FINANCIAL_USER=finanzas@example.com
IMAP_FINANCIAL_PASSWORD=pon_aqui_otra_contrasena_de_aplicacion

# Opcional: ruta a un archivo JSON alternativo de reglas financieras.
# IMAP_FINANCIAL_RULES=/ruta/a/financial_rules.json

# Configuración opcional del servidor MCP.
MCP_BIND_HOST=127.0.0.1
MCP_PORT=8000
MCP_TRANSPORT=streamable-http
